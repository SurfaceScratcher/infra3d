{
  "name": "@infra3d/app",
  "private": true,
  "version": "0.4.0",
  "description": "Self-hosted infra3d: imports compose stacks, checks every endpoint and shows the 3D view with root-cause hints.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:web": "vite --host",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "tsc -p server/tsconfig.json",
    "start": "node server/dist/index.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server/tsconfig.json",
    "dev:demo": "vite --host --mode demo",
    "build:demo": "vite build --mode demo"
  },
  "dependencies": {
    "infra3d": "0.3.1",
    "infra3d-import-compose": "0.3.0"
  },
  "devDependencies": {
    "@react-three/drei": "^10.0.7",
    "@react-three/fiber": "^9.1.2",
    "@types/node": "^22.19.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^9.2.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.187.0",
    "tsx": "^4.20.0",
    "vite": "^8.3.8"
  }
}
