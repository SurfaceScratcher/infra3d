{
  "name": "stratoscope-compose",
  "version": "0.3.6",
  "description": "Builds a stratoscope-infra topology from Docker Compose files (plain stack directories or an Ansible inventory).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SurfaceScratcher/stratoscope-infra.git",
    "directory": "packages/compose"
  },
  "homepage": "https://github.com/SurfaceScratcher/stratoscope-infra/tree/main/packages/compose#readme",
  "bugs": "https://github.com/SurfaceScratcher/stratoscope-infra/issues",
  "type": "module",
  "keywords": [
    "stratoscope",
    "stratoscope-infra",
    "docker-compose",
    "traefik",
    "ansible",
    "topology"
  ],
  "bin": {
    "stratoscope-compose": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "stratoscope.config.example.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "stratoscope-infra": "^0.9.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5"
  }
}
