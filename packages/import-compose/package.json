{
  "name": "infra3d-import-compose",
  "version": "0.3.0",
  "description": "Builds an infra3d topology from Docker Compose files (plain stack directories or an Ansible inventory).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SurfaceScratcher/infra3d.git",
    "directory": "packages/import-compose"
  },
  "homepage": "https://github.com/SurfaceScratcher/infra3d/tree/main/packages/import-compose#readme",
  "bugs": "https://github.com/SurfaceScratcher/infra3d/issues",
  "type": "module",
  "keywords": [
    "infra3d",
    "docker-compose",
    "traefik",
    "ansible",
    "topology"
  ],
  "bin": {
    "infra3d-import-compose": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "infra3d.config.example.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "infra3d": "^0.3.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5"
  }
}
