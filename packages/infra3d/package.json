{
  "name": "infra3d",
  "version": "0.1.0",
  "description": "Navigable 3D view of IT infrastructure for React: hosts, networks, containers and endpoints as stacked layers, with dependency and impact highlighting.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SurfaceScratcher/infra3d.git",
    "directory": "packages/infra3d"
  },
  "homepage": "https://github.com/SurfaceScratcher/infra3d/tree/main/packages/infra3d#readme",
  "bugs": "https://github.com/SurfaceScratcher/infra3d/issues",
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "react",
    "three",
    "react-three-fiber",
    "infrastructure",
    "topology",
    "network",
    "docker",
    "visualization",
    "3d"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./topology.schema.json": "./topology.schema.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "topology.schema.json"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "react": "^19.0.0",
    "three": ">=0.159.0"
  },
  "peerDependenciesMeta": {
    "@react-three/drei": {
      "optional": true
    },
    "@react-three/fiber": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "@react-three/drei": "^10.0.7",
    "@react-three/fiber": "^9.1.2",
    "@types/react": "^19.1.2",
    "@types/three": "^0.169.0",
    "react": "^19.1.0",
    "three": "^0.169.0",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}
