{
  "name": "infra3d-import-ci",
  "version": "0.0.0",
  "private": true,
  "description": "Builds a layered topology of Woodpecker CI pipelines, workflows and steps, with their dependencies and state.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SurfaceScratcher/infra3d.git",
    "directory": "packages/import-ci"
  },
  "homepage": "https://github.com/SurfaceScratcher/infra3d/tree/main/packages/import-ci#readme",
  "bugs": "https://github.com/SurfaceScratcher/infra3d/issues",
  "type": "module",
  "keywords": ["infra3d", "woodpecker", "ci", "pipelines", "topology"],
  "bin": {
    "infra3d-import-ci": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "infra3d": "^0.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5"
  }
}
