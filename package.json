{
  "name": "infra3d-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @infra3d/demo",
    "build": "npm run build -w infra3d && npm run build -w @infra3d/demo",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "import:server-stack": "node packages/import-compose/src/import-server-stack.mjs ../server-stack apps/demo/src/data/local.json"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
